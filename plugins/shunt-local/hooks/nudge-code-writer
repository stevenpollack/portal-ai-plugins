#!/bin/bash
# UserPromptSubmit: when the prompt asks for boilerplate, remind Claude to delegate
# before it starts generating. Advice only. Write is never gated, because a hook
# on Write fires after the expensive part (generation) is already spent.

prompt=$(jq -r '.prompt // empty')
grep -qiwE 'tests?|specs?|configs?|stubs?|boilerplate|fixtures?|docstrings?|scaffold' <<<"$prompt" || exit 0

jq -n '{hookSpecificOutput: {hookEventName: "UserPromptSubmit", additionalContext: "shunt-local: if most of this output is predictable from existing files, delegate to Agent(subagent_type=\"shunt-local:code-writer\") with a spec, reference paths, and a target path. It writes to disk and no generated code enters your context."}}'
